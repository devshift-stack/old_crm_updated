# Mac Remote Assistant - Environment Variables
# Copy this file to .env and fill in your API keys

# ===== AI PROVIDERS =====

# Claude (Anthropic) - Default AI
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ChatGPT (OpenAI) - Optional
OPENAI_API_KEY=sk-your-openai-key-here

# Grok (xAI) - Optional
XAI_API_KEY=your-xai-key-here
# Alternative name:
# GROK_API_KEY=your-grok-key-here

# ===== APP CONFIGURATION =====

# Autonomous Agent
ENABLE_AUTONOMOUS_AGENT=true
AUTONOMOUS_AGENT_LEVEL=normal  # minimal, normal, maximum

# Voice Control
ENABLE_VOICE_CONTROL=false
VOICE_LANGUAGE=de-DE
VOICE_NAME=Anna

# Background Monitor
ENABLE_BACKGROUND_MONITOR=true
EMAIL_CHECK_INTERVAL=300      # seconds (5 min)
MESSAGE_CHECK_INTERVAL=180    # seconds (3 min)

# ===== PLUGINS =====

# Enable/Disable specific plugins
PLUGIN_MAIL_ENABLED=true
PLUGIN_SLACK_ENABLED=true
PLUGIN_VIBER_ENABLED=true
PLUGIN_TELEGRAM_ENABLED=true
PLUGIN_PHOTOS_ENABLED=true

# ===== CLOUD AGENTS (REMOTE ACCESS) =====

# Slack Bot - Control Mac from Slack (Recommended!)
ENABLE_SLACK_BOT=true
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here  # For Socket Mode

# Telegram Bot - Control Mac from Telegram (Optional)
ENABLE_TELEGRAM_BOT=false
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Web Server - Browser access to Mac
ENABLE_WEB_SERVER=true
WEB_SERVER_HOST=0.0.0.0  # Listen on all interfaces
WEB_SERVER_PORT=5000      # Default port

# Cloud Sync - Automatic backup to cloud storage
ENABLE_CLOUD_SYNC=false
CLOUD_SYNC_DIR=~/Dropbox/MacAssistant  # Or Google Drive path
CLOUD_SYNC_INTERVAL=3600  # seconds (1 hour)

# ===== ADVANCED =====

# Database location
DATABASE_PATH=~/.mac_assistant/activities.db

# Log level
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# Active AI Provider
ACTIVE_AI_PROVIDER=claude  # claude, chatgpt, grok
