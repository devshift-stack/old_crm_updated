# Mac Remote Assistant - Optimized Configuration
# Your Setup: Linear User + Web Dashboard + Cloud Sync

# ===== AI PROVIDERS =====

# Claude (Anthropic) - Default AI
ANTHROPIC_API_KEY=sk-ant-DEIN-API-KEY-HIER

# Optional: ChatGPT (OpenAI)
# OPENAI_API_KEY=sk-your-openai-key-here

# Optional: Grok (xAI)
# XAI_API_KEY=your-xai-key-here

# ===== APP CONFIGURATION =====

# Autonomous Agent
ENABLE_AUTONOMOUS_AGENT=true
AUTONOMOUS_AGENT_LEVEL=normal  # minimal, normal, maximum

# Voice Control (Optional)
ENABLE_VOICE_CONTROL=false
VOICE_LANGUAGE=de-DE
VOICE_NAME=Anna

# Background Monitor
ENABLE_BACKGROUND_MONITOR=true
EMAIL_CHECK_INTERVAL=300      # seconds (5 min)
MESSAGE_CHECK_INTERVAL=180    # seconds (3 min)

# ===== PLUGINS =====

# Enable/Disable specific plugins
PLUGIN_MAIL_ENABLED=true
PLUGIN_SLACK_ENABLED=true     # Slack Desktop Plugin (nicht Cloud Bot)
PLUGIN_VIBER_ENABLED=true
PLUGIN_TELEGRAM_ENABLED=true
PLUGIN_PHOTOS_ENABLED=true

# ===== CLOUD AGENTS (REMOTE ACCESS) =====

# Slack Bot - DISABLED (du nutzt Linear, nicht Slack)
ENABLE_SLACK_BOT=false
# SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# SLACK_APP_TOKEN=xapp-your-app-token-here

# Telegram Bot - DISABLED (optional, wenn du willst)
ENABLE_TELEGRAM_BOT=false
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Web Server - ENABLED ✅ (Dein Haupt-Interface!)
ENABLE_WEB_SERVER=true
WEB_SERVER_HOST=0.0.0.0  # Listen on all interfaces
WEB_SERVER_PORT=5000      # Default port

# Cloud Sync - ENABLED ✅ (Auto-Backup)
ENABLE_CLOUD_SYNC=true
CLOUD_SYNC_DIR=~/Dropbox/MacAssistant  # Oder: ~/Google Drive/MacAssistant
CLOUD_SYNC_INTERVAL=3600  # seconds (1 hour)

# ===== ADVANCED =====

# Database location
DATABASE_PATH=~/.mac_assistant/activities.db

# Log level
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# Active AI Provider
ACTIVE_AI_PROVIDER=claude  # claude, chatgpt, grok
